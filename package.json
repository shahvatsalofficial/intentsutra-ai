{
  "name": "intentsutra-ai",
  "version": "0.2.2",
  "private": false,
  "type": "module",
  "description": "IntentSutra AI: local-first requirements-to-evidence traceability CLI. Revision-bound requirement IDs, explicit unknowns, human approvals, hash-pinned evidence, stale-evidence detection, hash-chained audit log and independent audit reports in Markdown, HTML and JSON. 21 agent roles, 26 portable skills. Zero dependencies, no API keys.",
  "author": {
    "name": "Vatsal Shah",
    "url": "https://github.com/shahvatsalofficial"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "doctor": "node packages/cli/index.mjs doctor",
    "demo": "node scripts/demo.mjs",
    "start": "node packages/cli/index.mjs help",
    "audit": "node packages/cli/index.mjs audit --out audit-out",
    "proof": "node scripts/proof.mjs",
    "docs:build": "node documents/build.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "bin": {
    "intentsutra": "packages/cli/index.mjs",
    "intentsutra-ai": "packages/cli/index.mjs"
  },
  "homepage": "https://shahvatsalofficial.github.io/intentsutra-ai/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shahvatsalofficial/intentsutra-ai.git"
  },
  "bugs": {
    "url": "https://github.com/shahvatsalofficial/intentsutra-ai/issues"
  },
